# ---------------------------------------------------------------- secrets
# config.yml holds the Lichess API token.  It must never be committed.
# Everything else that used to be caught by a blanket `*.yml` is listed
# explicitly below, because the blanket rule also swallowed
# third_party/lichess-bot/lib/versioning.yml -- which lichess-bot reads at
# import time, so a fresh clone of this repository could not start the bot
# at all.  Narrow rules, and nothing silently missing.
/config.yml
config.yml.local

# ------------------------------------------------------------ environments
.venv/
.venv2/
venv/
env/
**/__pycache__
*.py[cod]
.vscode/*
.vs/*
.idea/workspace.xml
# Local Claude Code permission settings; personal, not project configuration.
.claude/settings.local.json
.claude/*.tmp.*

# ------------------------------------------------------- local run output
/engines/*
!/engines/README.md
lichess_bot_auto_logs/*
TEMP/*
*.pgn
*.log
# Timestamps of the bot's own outgoing challenges; local run state.
/daily_challenge_times.txt

# ------------------------------------------------------ engine build output
engine/*.dll
engine/*.so
engine/*.exe
engine/*.o
engine/net_random.bin
engine/ce_verify.exe
# engine/net2.bin and engine/net3.bin are deliberately *not* ignored: without
# a network a fresh checkout cannot use EvalMode=nnue at all, and exporting
# one needs torch, which the bot itself does not have.  net3.bin is the king
# bucket network the engine loads by default (6 MB, still well inside
# GitHub's 100 MB limit); net2.bin is its 1.5 MB predecessor, kept because it
# is what every measurement before the buckets was made against.

# ------------------------------------------------- network training output
# Training data and per-epoch snapshots, all far over GitHub's 100 MB limit.
nnue/data/*
nnue/*.exe
nnue/*.pt
nnue/*.bin
nnue/.scratch

# testsuite/results/ has its own .gitignore, which excludes everything it
# generates.  Nothing to add here.

# -------------------------------------------------- earlier experiments
# evaluationModel/ is the first attempt at a network, in Python, superseded by
# nnue/.  Kept on disk, deliberately out of the repository: the dataset beside
# it is ~100 GB and the code is of no use to anyone reading this project now.
evaluationModel/

# --------------------------------------------- prebuilt Stockfish binary
# Over GitHub's 100 MB limit.  Stockfish is used only as a sparring partner
# and as a referee for generating test positions -- see THIRD-PARTY.md.
third_party/stockfish/*.exe

# ------------------------------------------------------ CCRL release build
# Staged sources, intermediate binaries and the package, all regenerated by
# `python ccrl/build.py`.  The binaries carry net3.bin inside them, so each
# one is 6.8 MB -- not something to keep in history.  ccrl/ itself (build.py,
# src/, validate.toml, SUBMISSION.md) is tracked.
ccrl/build/
ccrl/dist/
